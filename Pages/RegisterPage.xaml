<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CogniBoost.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Регистрация"
    BackgroundColor="{StaticResource PageBackgroundLight}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Создать аккаунт" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryLight}" />

            <Entry x:Name="UsernameEntry" Placeholder="Имя пользователя"
                   TextColor="{StaticResource TextPrimaryLight}" PlaceholderColor="{StaticResource TextMutedLight}"
                   BackgroundColor="White" />
            <Entry x:Name="AgeEntry" Placeholder="Возраст" Keyboard="Numeric"
                   TextColor="{StaticResource TextPrimaryLight}" PlaceholderColor="{StaticResource TextMutedLight}"
                   BackgroundColor="White" />
            <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True"
                   TextColor="{StaticResource TextPrimaryLight}" PlaceholderColor="{StaticResource TextMutedLight}"
                   BackgroundColor="White" />
            <Entry x:Name="ConfirmEntry" Placeholder="Повторите пароль" IsPassword="True"
                   TextColor="{StaticResource TextPrimaryLight}" PlaceholderColor="{StaticResource TextMutedLight}"
                   BackgroundColor="White" />

            <Label
                x:Name="ErrorLabel"
                TextColor="{StaticResource Error}"
                FontSize="13"
                IsVisible="False" />

            <Button
                Text="Зарегистрироваться"
                Clicked="OnRegisterClicked"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="14" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
