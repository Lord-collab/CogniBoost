<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CogniBoost.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Игры"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header + Search -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,12" Spacing="12">
            <Label Text="Игры" FontSize="28" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            
            <SearchBar x:Name="SearchBar"
                       Placeholder="Поиск игры..."
                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       CancelButtonColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       SearchCommand="{Binding SearchCommand}"
                       TextChanged="OnSearchTextChanged" />
        </VerticalStackLayout>

        <!-- Category Chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="20,0,20,8">
            <HorizontalStackLayout x:Name="CategoryChips" Spacing="8" Padding="0,0,20,0" />
        </ScrollView>

        <!-- Games Grid/List (занимает оставшееся место, скроллится) -->
        <ScrollView Grid.Row="2" x:Name="GamesScroll">
            <VerticalStackLayout x:Name="GamesList" Padding="20,0,20,20" Spacing="12" />
        </ScrollView>
    </Grid>
</ContentPage>