<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CogniBoost.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Вход"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Вход" FontSize="28" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

            <Entry x:Name="UsernameEntry" Placeholder="Имя пользователя"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}" />
            <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}" />

            <Label
                x:Name="ErrorLabel"
                TextColor="{StaticResource Error}"
                FontSize="13"
                IsVisible="False" />

            <Button
                Text="Войти"
                Clicked="OnLoginClicked"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="14" />

            <Button
                Text="Забыли пароль?"
                Clicked="OnForgotPasswordClicked"
                BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                FontSize="14"
                HeightRequest="40" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
