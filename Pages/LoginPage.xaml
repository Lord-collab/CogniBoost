<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CogniBoost.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Вход"
    BackgroundColor="{StaticResource PageBackgroundLight}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Вход" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryLight}" />

            <Entry x:Name="UsernameEntry" Placeholder="Имя пользователя" />
            <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True" />

            <Label
                x:Name="ErrorLabel"
                TextColor="{StaticResource BrandRed}"
                FontSize="13"
                IsVisible="False" />

            <Button
                Text="Войти"
                Clicked="OnLoginClicked"
                BackgroundColor="{StaticResource BrandIndigo}"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="14" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
